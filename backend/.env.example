# ─── Database (SQLite) ────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to backend/).
# On Windows the installer sets this to an absolute path inside ProgramData.
DATABASE_URL="file:./storage/data/msl.db"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string-at-least-64-chars"
JWT_EXPIRES_IN="8h"
JWT_REMEMBER_EXPIRES_IN="30d"

# ─── Encryption ──────────────────────────────────────────────────────────────
# Encrypts secrets stored in the app_settings table (SMTP pass, WAHA key).
ENCRYPTION_KEY="change-me-to-a-unique-random-string"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
FRONTEND_DIST=../frontend/dist

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_ROOT=./storage

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

# ─── Scheduler ───────────────────────────────────────────────────────────────
SCHEDULER_INTERVAL_SEC=30
