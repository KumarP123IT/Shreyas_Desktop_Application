{
  "name": "smart-msl-monitor-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Smart MSL Monitor backend – Node/Express/Prisma/SQLite",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext js,json src/index.js",
    "start": "node src/index.js",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev --name",
    "seed": "node prisma/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "prisma generate",
    "firstrun": "node scripts/firstrun.js",
    "build": "echo 'Backend is plain Node.js – no build step needed'"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^9.6.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.4.168",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.1",
    "qrcode": "^1.5.4",
    "tesseract.js": "^5.1.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.14.0",
    "vitest": "^1.6.0"
  },
  "allowScripts": {
    "better-sqlite3@9.6.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  }
}
