# ─── Dependencies ────────────────────────────────────────────────────────────
# Matches node_modules at ANY level: root, frontend/, backend/
node_modules/
.pnp
.pnp.js

# ─── Environment & secrets ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.local.env
# Keep .env.example files — they are safe templates with no real secrets
!.env.example
!backend/.env.example
!frontend/.env.example

# ─── WAHA session data (contains WhatsApp auth keys — never commit) ──────────
waha-sessions/
*.sessions/

# ─── Database ─────────────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backend/storage/data/

# ─── Build outputs ───────────────────────────────────────────────────────────
frontend/dist/
dist-installer/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
*.log.*
logs/
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Storage (user-generated data — not source code) ─────────────────────────
backend/storage/uploads/
backend/storage/backups/
backend/storage/.firstrun_done

# Keep the storage directory itself (for README context)
!backend/storage/.gitkeep

# ─── Prisma ──────────────────────────────────────────────────────────────────
# Keep migrations — they define the schema history
# Ignore generated client (rebuilt on npm install)
backend/node_modules/.prisma/

# ─── Frontend tooling ────────────────────────────────────────────────────────
frontend/.vite/
frontend/coverage/

# ─── OS files ────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Editor / IDE ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Installer build artefacts ───────────────────────────────────────────────
installer/runtimes/
# Keep all asset files (icons, etc.)
!installer/assets/
!installer/assets/**

# ─── Misc ────────────────────────────────────────────────────────────────────
*.tgz
*.zip
.cache/
tmp/
.tmp/

# Test/coverage output anywhere in the repo
coverage/
*.lcov

# OS-generated files
*~
.#*

