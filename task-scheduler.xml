<?xml version="1.0" encoding="UTF-16"?>
<!--
  Windows Task Scheduler job: auto-start Smart MSL Monitor at user logon.

  IMPORTANT: replace C:\SmartMSLMonitor with the actual folder where this
  project is installed, in BOTH places below (Command and WorkingDirectory).

  Install:
    schtasks /Create /TN "SmartMSLMonitor" /XML "task-scheduler.xml" /F

  Or simply run install-autostart.bat which does this for you.

  Remove:
    schtasks /Delete /TN "SmartMSLMonitor" /F
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Starts the Smart MSL Monitor backend + frontend on Windows logon.</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>wscript.exe</Command>
      <Arguments>"C:\SmartMSLMonitor\start-app-hidden.vbs"</Arguments>
      <WorkingDirectory>C:\SmartMSLMonitor</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
