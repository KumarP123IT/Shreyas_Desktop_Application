# ─── Smart MSL Monitor – root .env.example ──────────────────────────────────
# Copy this to .env and fill in your values.
# The NSIS installer auto-generates this file with secure random secrets.

# ─── Database (SQLite – no separate server needed) ───────────────────────────
# Path is relative to /backend. On Windows the installer uses an absolute path
# inside %APPDATA%\SmartMSLMonitor\data\msl.db
DATABASE_URL="file:./storage/data/msl.db"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string-at-least-64-chars"
JWT_EXPIRES_IN="8h"
JWT_REMEMBER_EXPIRES_IN="30d"

# ─── Encryption ──────────────────────────────────────────────────────────────
# Encrypts secrets stored in the app_settings table (SMTP password etc.).
ENCRYPTION_KEY="change-me-to-a-unique-random-string"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
FRONTEND_DIST=../frontend/dist

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_ROOT=./storage

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

# ─── Scheduler ───────────────────────────────────────────────────────────────
SCHEDULER_INTERVAL_SEC=30

# ─── WhatsApp ────────────────────────────────────────────────────────────────
# No external service needed — WhatsApp runs via the built-in Baileys client.
# Pair it once via Settings → WhatsApp → Show QR Code.
